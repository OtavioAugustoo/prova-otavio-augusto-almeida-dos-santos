<!-- ===== Nota ===== -->
<mxCell id="nota" value="Padrão Abstract Factory&#xa;RNF01: cada fábrica concreta cria apenas a família de artefatos do seu país; os produtos concretos têm visibilidade de pacote, só a fábrica do país os instancia.&#xa;RNF02: ConfirmacaoReserva depende só das interfaces e recebe a fábrica pelo construtor.&#xa;RNF03: novo país = nova fábrica + 3 novos produtos, sem alterar ConfirmacaoReserva." style="shape=note;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;size=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="20" width="990" height="120" as="geometry"/></mxCell>

